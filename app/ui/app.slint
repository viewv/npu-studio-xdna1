// NPU Studio — 主界面
import { Button, Switch, ComboBox, Slider, ScrollView, TextEdit, Palette } from "std-widgets.slint";

export struct FeatureData {
    id: string,
    title: string,
    description: string,
    tag: string,          // 例如 "NPU"、"即将推出"
    available: bool,
    enabled: bool,
}

// 运行状态: 0 已停止, 1 启动中, 2 运行中, 3 停止中, 4 出错
export global Theme {
    out property <color> npu: #7c5cff;
    out property <color> ok: #2fbf71;
    out property <color> warn: #e5a50a;
    out property <color> err: #e5484d;
    out property <color> muted: Palette.foreground.with-alpha(0.6);
    out property <color> card: Palette.color-scheme == ColorScheme.dark ? #ffffff0d : #0000000a;
    out property <color> card-border: Palette.color-scheme == ColorScheme.dark ? #ffffff1a : #00000014;
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        if root.title != "": VerticalLayout {
            spacing: 2px;
            Text { text: root.title; font-size: 14px; font-weight: 700; }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 11px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        @children
    }
}

component Tag inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.npu;
    border-radius: 6px;
    background: root.tint.with-alpha(0.18);
    height: 18px;
    width: label.preferred-width + 12px;
    label := Text {
        text: root.text;
        font-size: 10px;
        font-weight: 700;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component BackendOption inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> tag;
    in property <bool> selected;
    in property <bool> available: true;
    in property <bool> locked;       // 运行中只能先停止再切换
    callback clicked;
    min-height: 50px;
    border-radius: 10px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.npu : Theme.card-border;
    background: root.selected ? Theme.npu.with-alpha(0.12)
        : (touch.has-hover && root.available && !root.locked ? Theme.card : transparent);
    opacity: root.available ? 1.0 : 0.45;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 2px;
                border-color: root.selected ? Theme.npu : Theme.muted;
                Rectangle {
                    visible: root.selected;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.npu;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.label; font-weight: 600; vertical-alignment: center; }
                if root.tag != "": Tag { text: root.tag; y: 1px; }
                Rectangle { }
            }
            Text { text: root.hint; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        }
    }
    touch := TouchArea {
        enabled: root.available && !root.locked;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 32px;
    border-radius: 8px;
    background: root.selected ? Theme.npu : (touch.has-hover ? Theme.card : transparent);
    Text {
        text: root.text;
        color: root.selected ? white : Palette.foreground;
        font-weight: root.selected ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FeatureRow inherits Rectangle {
    in property <FeatureData> data;
    callback toggled(bool);
    min-height: 38px;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.data.title;
                    font-weight: 600;
                    color: root.data.available ? Palette.foreground : Theme.muted;
                }
                if root.data.tag != "": VerticalLayout {
                    alignment: center;
                    Tag {
                        text: root.data.tag;
                        tint: root.data.available ? Theme.npu : Theme.muted;
                    }
                }
                Rectangle { }
            }
            Text {
                text: root.data.description;
                font-size: 11px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        if root.data.available: VerticalLayout {
            alignment: center;
            Switch {
                checked: root.data.enabled;
                toggled => { root.toggled(self.checked); }
            }
        }
    }
}

component ToolCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> tech-tag;
    in property <string> status-tag;
    in property <string> open-label: "进入 →";
    in property <color> status-tint: Theme.muted;
    callback clicked;

    border-radius: 12px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.npu : Theme.card-border;
    background: touch.has-hover ? Theme.npu.with-alpha(0.06) : Theme.card;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.title; font-size: 15px; font-weight: 700; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                Tag { text: root.status-tag; tint: root.status-tint; }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: root.subtitle;
            font-size: 12px;
            color: Theme.muted;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; min-height: 4px; }
        HorizontalLayout {
            height: 30px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Tag { text: root.tech-tag; tint: Theme.npu; }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 78px;
                height: 30px;
                border-radius: 8px;
                background: touch.has-hover ? Theme.npu : Theme.npu.with-alpha(0.14);
                Text {
                    text: root.open-label;
                    font-size: 12px;
                    font-weight: 700;
                    color: touch.has-hover ? #ffffff : Theme.npu;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <color> accent: Palette.foreground;
    background: Theme.card;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    min-height: 62px;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: root.label; font-size: 11px; color: Theme.muted; }
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            Text { text: root.value; font-size: 20px; font-weight: 700; color: root.accent; }
            Text { text: root.unit; font-size: 11px; color: Theme.muted; vertical-alignment: bottom; }
        }
    }
}

component StartButton inherits Rectangle {
    in property <int> state;
    in property <bool> is-en: false;
    callback clicked;
    height: 48px;
    border-radius: 12px;
    property <bool> busy: root.state == 1 || root.state == 3;
    property <bool> running: root.state == 2;
    background: root.running ? (touch.has-hover ? Theme.err.darker(0.1) : Theme.err)
        : (touch.has-hover ? Theme.npu.darker(0.1) : Theme.npu);
    opacity: root.busy ? 0.6 : 1.0;
    animate background { duration: 150ms; }
    Text {
        text: root.state == 1 ? (root.is-en ? "Starting…" : "正在启动…")
            : root.state == 3 ? (root.is-en ? "Stopping…" : "正在停止…")
            : root.running ? (root.is-en ? "■  Stop" : "■  停止")
            : (root.is-en ? "▶  Start" : "▶  开启");
        color: white;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "NPU Studio";
    icon: @image-url("../assets/npu-studio.svg");
    preferred-width: 1060px;
    preferred-height: 760px;
    min-width: 860px;
    min-height: 600px;

    // ---- 后端 ----
    in-out property <int> backend: 0;     // 0 NPU, 1 GPU rusticl, 2 GPU ROCm, 3 CPU
    in property <bool> npu-available: true;
    in property <bool> rusticl-available: true;
    in property <bool> rocm-available: true;

    // ---- 抠像模型 ----
    in-out property <int> matting: 0;      // 0 MediaPipe, 1 RVM 核显, 2 RVM CPU
    in property <bool> rvm-gpu-available: true;
    in property <bool> rvm-cpu-available: true;

    // ---- 背景效果 ----
    in-out property <int> bg-mode: 0;      // 0 虚化, 1 图片, 2 绿幕
    in-out property <float> blur-strength: 61;
    in-out property <float> smoothing: 0.5;
    in property <string> bg-image-name;

    // ---- 摄像头 ----
    in property <[string]> cameras;
    in-out property <int> camera-index: 0;
    in-out property <bool> high-fps: false;

    // ---- 其他功能 (由 Rust 端注册) ----
    in property <[FeatureData]> features;

    // ---- 运行状态 ----
    in property <int> run-state: 0;
    in property <string> status-text: "未运行";
    in property <string> error-text;
    in property <string> backend-name;
    in property <image> preview;
    in property <bool> has-preview: false;
    in property <float> fps;
    in property <float> seg-ms;
    in property <float> fx-ms;
    in property <float> prep-ms;
    in property <float> accel-ms;
    in property <float> cpu-pct;
    in property <float> person-pct;

    // ---- 虚拟摄像头 ----
    in property <string> vcam-device;      // 空 = 未加载
    in property <bool> vcam-autoload;
    in property <bool> vcam-busy;

    // ---- 导航页签: 0 工具箱首页, 1 背景虚化, 2 实时语音转写 ----
    in-out property <int> active-tab: 0;
    in-out property <bool> is-en: false;

    // ---- 实时语音转写 ----
    in-out property <int> asr-backend: 0; // 0 NPU C++ 四档, 1 CPU Python
    in-out property <bool> asr-active: false;
    in-out property <string> asr-status: "未开启";
    in-out property <string> asr-bucket: "–";
    in-out property <string> asr-ms: "–";
    in-out property <string> asr-text;
    in-out property <string> asr-partial;

    // ---- 屏幕框选 OCR ----
    in-out property <int> ocr-backend: 0; // 0 NPU+CPU 异构, 1 CPU float32
    in-out property <bool> ocr-busy: false;
    in-out property <string> ocr-status: "Idle";
    in-out property <string> ocr-det-ms: "–";
    in-out property <string> ocr-rec-ms: "–";
    in-out property <string> ocr-boxes: "–";
    in-out property <string> ocr-text;
    in-out property <image> ocr-preview;
    in-out property <bool> ocr-has-preview: false;

    callback start-stop();
    callback settings-changed();
    callback pick-image();
    callback load-vcam();
    callback unload-vcam();
    callback setup-autoload();
    callback feature-toggled(int, bool);
    callback asr-start-stop();
    callback asr-clear();
    callback ocr-init();
    callback ocr-snip();
    callback ocr-clear();
    callback ocr-copy();
    callback toggle-lang();

    property <bool> locked: root.run-state == 1 || root.run-state == 3;
    property <bool> running: root.run-state == 2;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ================= 顶部 Toolbox 导航栏 =================
        HorizontalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 10px;
                Image {
                    source: @image-url("../assets/npu-studio.svg");
                    width: 34px;
                    height: 34px;
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: "NPU Studio"; font-size: 18px; font-weight: 800; }
                    Text { text: root.is-en ? "Ryzen AI NPU Toolbox" : "Ryzen AI NPU 工具箱"; font-size: 11px; color: Theme.muted; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                width: 390px;
                spacing: 4px;
                Segment {
                    text: root.is-en ? "Toolbox" : "工具箱";
                    selected: root.active-tab == 0;
                    clicked => { root.active-tab = 0; }
                }
                Segment {
                    text: root.running ? (root.is-en ? "Video Blur ●" : "背景虚化 ●") : (root.is-en ? "Video Blur" : "背景虚化");
                    selected: root.active-tab == 1;
                    clicked => { root.active-tab = 1; }
                }
                Segment {
                    text: root.asr-active ? (root.is-en ? "Speech ASR ●" : "语音转写 ●") : (root.is-en ? "Speech ASR" : "语音转写");
                    selected: root.active-tab == 2;
                    clicked => { root.active-tab = 2; }
                }
                Segment {
                    text: root.ocr-busy ? (root.is-en ? "Screen OCR ●" : "屏幕 OCR ●") : (root.is-en ? "Screen OCR" : "屏幕 OCR");
                    selected: root.active-tab == 3;
                    clicked => { root.active-tab = 3; root.ocr-init(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: root.is-en ? "中文" : "EN";
                    clicked => { root.toggle-lang(); }
                }
            }
        }

        // ================= Tab 0: 工具箱首页 =================
        if root.active-tab == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            HorizontalLayout {
                height: 146px;
                spacing: 14px;
                ToolCard {
                    horizontal-stretch: 1;
                    title: root.is-en ? "Background Blur Virtual Camera" : "背景虚化虚拟摄像头";
                    subtitle: root.is-en ? "Real-time portrait matting + blur / background image / green screen via v4l2loopback." : "实时人像分割 + 背景虚化 / 换图 / 绿幕，输出到 v4l2loopback 虚拟摄像头。";
                    tech-tag: "NPU / GPU / CPU";
                    status-tag: root.running ? (root.is-en ? "Running" : "运行中") : (root.is-en ? "Stopped" : "未运行");
                    status-tint: root.running ? Theme.ok : Theme.muted;
                    open-label: root.is-en ? "Open →" : "进入 →";
                    clicked => { root.active-tab = 1; }
                }
                ToolCard {
                    horizontal-stretch: 1;
                    title: root.is-en ? "Live Speech Recognition (ASR)" : "实时语音转写 (ASR)";
                    subtitle: root.is-en ? "Real-time streaming microphone transcription with 4-bucket NPU C++ (137–320ms) or CPU." : "麦克风实时流式上屏，支持 NPU 4 核四档分档 (137–320ms) 与 CPU 后端对比。";
                    tech-tag: "NPU C++ / CPU";
                    status-tag: root.asr-active ? root.asr-status : (root.is-en ? "Idle" : "未开启");
                    status-tint: root.asr-active ? Theme.ok : Theme.muted;
                    open-label: root.is-en ? "Open →" : "进入 →";
                    clicked => { root.active-tab = 2; }
                }
                ToolCard {
                    horizontal-stretch: 1;
                    title: root.is-en ? "Screen Snip OCR" : "屏幕框选 OCR";
                    subtitle: root.is-en ? "Drag a screen region to recognize Chinese & English text with PP-OCRv4 on NPU+CPU." : "框选屏幕区域识别中英文文本，NPU 跑主干卷积 + CPU 跑检测/解码头。";
                    tech-tag: "NPU + CPU";
                    status-tag: root.ocr-status;
                    status-tint: root.ocr-busy ? Theme.warn : Theme.muted;
                    open-label: root.is-en ? "Open →" : "进入 →";
                    clicked => { root.active-tab = 3; root.ocr-init(); }
                }
            }

            Card {
                title: root.is-en ? "Labs / More Features" : "实验室 / 更多功能";
                subtitle: root.is-en ? "Experimental NPU workloads to be added in future updates." : "后续会陆续加入更多在 NPU 上运行的独立工具模块。";
                for f[i] in root.features: FeatureRow {
                    data: f;
                    toggled(v) => { root.feature-toggled(i, v); }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        // ================= Tab 1: 背景虚化摄像头 =================
        if root.active-tab == 1: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

        // ================= 左栏: 设置 =================
        ScrollView {
            width: 400px;
            VerticalLayout {
                spacing: 12px;
                padding-right: 8px;

                StartButton {
                    state: root.run-state;
                    is-en: root.is-en;
                    clicked => { root.start-stop(); }
                }

                Card {
                    title: root.is-en ? "Compute Backend" : "计算后端";
                    subtitle: root.is-en ? "Where full-res matting & compositing run. Restarts automatically if changed while running." : "全分辨率的遮罩与合成在哪里计算。运行中切换会自动重启。";
                    BackendOption {
                        label: "NPU";
                        tag: root.is-en ? "Recommended" : "推荐";
                        hint: root.is-en ? "Ryzen AI fused kernel · Fastest · Zero GPU load" : "Ryzen AI 融合内核 · 最快 · 不占用 GPU";
                        selected: root.backend == 0;
                        available: root.npu-available;
                        locked: root.locked;
                        clicked => { root.backend = 0; root.settings-changed(); }
                    }
                    BackendOption {
                        label: "GPU · Mesa";
                        hint: "Radeon 780M · OpenCL (rusticl)";
                        selected: root.backend == 1;
                        available: root.rusticl-available;
                        locked: root.locked;
                        clicked => { root.backend = 1; root.settings-changed(); }
                    }
                    BackendOption {
                        label: "GPU · ROCm";
                        hint: "Radeon 780M · OpenCL (ROCm)";
                        selected: root.backend == 2;
                        available: root.rocm-available;
                        locked: root.locked;
                        clicked => { root.backend = 2; root.settings-changed(); }
                    }
                    BackendOption {
                        label: "CPU";
                        hint: root.is-en ? "No accelerator · Best compatibility" : "无需加速器 · 兼容性最好";
                        selected: root.backend == 3;
                        locked: root.locked;
                        clicked => { root.backend = 3; root.settings-changed(); }
                    }
                }

                Card {
                    title: root.is-en ? "Matting Model" : "抠像模型";
                    subtitle: root.is-en ? "Edge quality & temporal stability. Restarts automatically if switched." : "决定人物边缘的精细程度。运行中切换会自动重启。";
                    BackendOption {
                        label: root.is-en ? "RVM · Hardware Accel" : "RVM · 硬件加速";
                        tag: root.is-en ? "Recommended" : "推荐";
                        hint: !root.rvm-gpu-available ? (root.is-en ? "Requires worker/model export (see README)" : "需先生成 worker 和模型, 见 README")
                            : root.backend == 0 ? (root.is-en ? "Hair-level edges · No ghosting · Runs on NPU" : "头发丝级边缘 · 不拖影 · 随上方后端跑在 NPU 上")
                            : root.backend == 3 ? (root.is-en ? "Hair-level edges · Falls back to CPU" : "头发丝级边缘 · 不拖影 · 将回退到 CPU")
                            : (root.is-en ? "Hair-level edges · No ghosting · Runs on 780M iGPU" : "头发丝级边缘 · 不拖影 · 随上方后端跑在 780M 核显上");
                        selected: root.matting == 1;
                        available: root.rvm-gpu-available;
                        locked: root.locked;
                        clicked => { root.matting = 1; root.settings-changed(); }
                    }
                    BackendOption {
                        label: "MediaPipe";
                        hint: root.is-en ? "Lightweight · Fair edges · May ghost on fast motion" : "很轻, 边缘一般 · 动作大时会有拖影";
                        selected: root.matting == 0;
                        locked: root.locked;
                        clicked => { root.matting = 0; root.settings-changed(); }
                    }
                    BackendOption {
                        label: "RVM · CPU";
                        hint: root.is-en ? "Same quality · Uses ~2+ CPU cores" : "效果同上, 但要占用 2 个多 CPU 核";
                        selected: root.matting == 2;
                        available: root.rvm-cpu-available;
                        locked: root.locked;
                        clicked => { root.matting = 2; root.settings-changed(); }
                    }
                }

                Card {
                    title: root.is-en ? "Background" : "背景";
                    subtitle: root.is-en ? "How pixels outside the person are rendered." : "人物之外的部分怎么处理。";
                    HorizontalLayout {
                        spacing: 4px;
                        Segment {
                            text: root.is-en ? "Blur" : "虚化";
                            selected: root.bg-mode == 0;
                            clicked => { root.bg-mode = 0; root.settings-changed(); }
                        }
                        Segment {
                            text: root.is-en ? "Image" : "替换图片";
                            selected: root.bg-mode == 1;
                            clicked => { root.bg-mode = 1; root.settings-changed(); }
                        }
                        Segment {
                            text: root.is-en ? "Green" : "绿幕";
                            selected: root.bg-mode == 2;
                            clicked => { root.bg-mode = 2; root.settings-changed(); }
                        }
                    }
                    if root.bg-mode == 0: VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: "模糊强度"; font-size: 12px; }
                            Rectangle { }
                            Text { text: round(root.blur-strength); font-size: 12px; color: Theme.muted; }
                        }
                        Slider {
                            minimum: 21;
                            maximum: 151;
                            value <=> root.blur-strength;
                            released => { root.settings-changed(); }
                        }
                    }
                    if root.bg-mode == 1: HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.bg-image-name == "" ? "还没有选择图片" : root.bg-image-name;
                            color: root.bg-image-name == "" ? Theme.warn : Palette.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: root.is-en ? "Choose Image…" : "选择图片…";
                            clicked => { root.pick-image(); }
                        }
                    }
                    if root.matting == 0: VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: root.is-en ? "Edge Stability (Temporal)" : "边缘稳定 (时间平滑)"; font-size: 12px; }
                            Rectangle { }
                            Text { text: round(root.smoothing * 100) + "%"; font-size: 12px; color: Theme.muted; }
                        }
                        Slider {
                            minimum: 0;
                            maximum: 0.9;
                            value <=> root.smoothing;
                            released => { root.settings-changed(); }
                        }
                    }
                    if root.matting != 0: HorizontalLayout {
                        spacing: 6px;
                        Text { text: root.is-en ? "Edge Stability (Temporal)" : "边缘稳定 (时间平滑)"; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                        Tag { text: root.is-en ? "Built into RVM" : "RVM 已内置"; tint: Theme.ok; }
                        Rectangle { }
                    }
                }

                Card {
                    title: root.is-en ? "Camera" : "摄像头";
                    ComboBox {
                        model: root.cameras;
                        current-index <=> root.camera-index;
                        selected => { root.settings-changed(); }
                    }
                    HorizontalLayout {
                        VerticalLayout {
                            alignment: center;
                            Text { text: root.is-en ? "High FPS Mode" : "高帧率模式"; font-weight: 600; }
                            Text {
                                text: root.is-en ? "Lock 30 fps (image gets darker in low light)" : "关闭动态帧率, 稳定 30 fps (光线暗时画面会变暗)";
                                font-size: 11px;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> root.high-fps;
                                toggled => { root.settings-changed(); }
                            }
                        }
                    }
                }

            }
        }

        // ================= 右栏: 预览与状态 =================
        VerticalLayout {
            spacing: 12px;

            // 状态条
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: root.run-state == 2 ? Theme.ok : root.run-state == 4 ? Theme.err
                        : root.locked ? Theme.warn : Theme.muted;
                }
                Text { text: root.status-text; font-weight: 600; vertical-alignment: center; }
                Rectangle { }
                Text { text: root.backend-name; font-size: 11px; color: Theme.muted; vertical-alignment: center; }
            }

            // 预览
            Rectangle {
                background: #000;
                border-radius: 12px;
                clip: true;
                min-height: 240px;
                vertical-stretch: 1;
                Image {
                    visible: root.has-preview;
                    source: root.preview;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
                if !root.has-preview: VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: root.running ? (root.is-en ? "Waiting for frames…" : "等待画面…") : (root.is-en ? "Click Start to preview here" : "点击「开启」后在这里预览");
                        color: #ffffffaa;
                        font-size: 15px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.is-en ? "Select \"NPU Studio Camera\" in your meeting app" : "会议软件里选择摄像头「NPU Studio Camera」";
                        color: #ffffff66;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }

            // 错误
            if root.error-text != "": Rectangle {
                background: Theme.err.with-alpha(0.12);
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.err.with-alpha(0.5);
                VerticalLayout {
                    padding: 10px;
                    Text { text: root.error-text; color: Theme.err; wrap: word-wrap; font-size: 12px; }
                }
            }

            // 数字
            GridLayout {
                spacing: 8px;
                Row {
                    StatTile {
                        label: root.is-en ? "Frame Rate" : "帧率";
                        value: root.running ? round(root.fps * 10) / 10 : "–";
                        unit: "fps";
                        accent: root.running ? Theme.ok : Palette.foreground;
                    }
                    StatTile {
                        label: root.is-en ? "Matting" : "人像分割";
                        value: root.running ? round(root.seg-ms * 10) / 10 : "–";
                        unit: "ms";
                    }
                    StatTile {
                        label: root.is-en ? "Composite" : "遮罩与合成";
                        value: root.running ? round(root.fx-ms * 10) / 10 : "–";
                        unit: "ms";
                    }
                }
                Row {
                    StatTile {
                        label: root.backend == 0 ? (root.is-en ? "NPU Time" : "其中 NPU")
                            : root.backend == 3 ? (root.is-en ? "Accel Time" : "其中加速器")
                            : (root.is-en ? "GPU Time" : "其中 GPU");
                        value: root.running && root.backend != 3 ? round(root.accel-ms * 10) / 10 : "–";
                        unit: "ms";
                        accent: root.backend == 0 && root.running ? Theme.npu : Palette.foreground;
                    }
                    StatTile {
                        label: root.is-en ? "Process CPU" : "进程 CPU";
                        value: root.running ? round(root.cpu-pct) : "–";
                        unit: root.is-en ? "% 1-core" : "% 单核";
                    }
                    StatTile {
                        label: root.is-en ? "Foreground" : "画面中人物";
                        value: root.running ? round(root.person-pct) : "–";
                        unit: "%";
                    }
                }
            }

            // 虚拟摄像头
            Card {
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: root.is-en ? "Virtual Camera" : "虚拟摄像头"; font-weight: 700; }
                            Tag {
                                text: root.vcam-device != "" ? ((root.is-en ? "Ready " : "已就绪 ") + root.vcam-device) : (root.is-en ? "Not Loaded" : "未加载");
                                tint: root.vcam-device != "" ? Theme.ok : Theme.warn;
                            }
                            Rectangle { }
                        }
                        Text {
                            text: root.vcam-autoload ? (root.is-en ? "Autoloads on boot (v4l2loopback)" : "开机会自动加载 (v4l2loopback)") : (root.is-en ? "Load once per boot (v4l2loopback)" : "每次开机需要加载一次 (v4l2loopback)");
                            font-size: 11px;
                            color: Theme.muted;
                        }
                    }
                    if root.vcam-device == "": VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button {
                            text: root.is-en ? "Load" : "加载";
                            enabled: !root.vcam-busy;
                            clicked => { root.load-vcam(); }
                        }
                    }
                    if root.vcam-device != "": VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button {
                            text: root.is-en ? "Unload" : "卸载";
                            enabled: !root.vcam-busy && !root.running && !root.locked;
                            clicked => { root.unload-vcam(); }
                        }
                    }
                    if !root.vcam-autoload: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        Button {
                            text: root.is-en ? "Autoload on Boot" : "开机自动加载";
                            enabled: !root.vcam-busy;
                            clicked => { root.setup-autoload(); }
                        }
                    }
                }
            }
        }
        }

        // ================= Tab 2: 实时语音转写 =================
        if root.active-tab == 2: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            VerticalLayout {
                width: 360px;
                spacing: 12px;

                Button {
                    height: 44px;
                    text: root.asr-active ? (root.is-en ? "Stop Listening" : "停止监听") : (root.is-en ? "Start Live ASR" : "开始实时转写");
                    primary: !root.asr-active;
                    clicked => { root.asr-start-stop(); }
                }

                Card {
                    title: root.is-en ? "ASR Backend" : "语音识别后端";
                    subtitle: root.is-en ? "Switch between 4-core NPU or CPU reference. Stop listening before switching." : "可切换 NPU 或 CPU 实现，运行中切换会先停止当前监听。";
                    BackendOption {
                        label: root.is-en ? "NPU · 4-Core Buckets (C++)" : "NPU · 4 核四档 (C++)";
                        tag: root.is-en ? "Recommended" : "推荐";
                        hint: root.is-en ? "2/3/5/7s auto buckets · 137–320 ms · Zero CPU load" : "2/3/5/7 秒自动分档 · 137–320 ms · 不占 CPU";
                        selected: root.asr-backend == 0;
                        locked: root.asr-active;
                        clicked => { root.asr-backend = 0; }
                    }
                    BackendOption {
                        label: root.is-en ? "CPU · Python Reference" : "CPU · Python 参考";
                        hint: root.is-en ? "OpenBLAS float32 · No NPU · ~1.1 s" : "OpenBLAS 浮点参考 · 无需 NPU · 约 1.1 s";
                        selected: root.asr-backend == 1;
                        locked: root.asr-active;
                        clicked => { root.asr-backend = 1; }
                    }
                }

                GridLayout {
                    spacing: 8px;
                    Row {
                        StatTile {
                            label: root.is-en ? "Active Bucket" : "当前档位";
                            value: root.asr-bucket;
                            unit: "";
                            accent: root.asr-active ? Theme.npu : Palette.foreground;
                        }
                        StatTile {
                            label: root.is-en ? "End-to-End" : "端到端耗时";
                            value: root.asr-ms;
                            unit: "ms";
                            accent: root.asr-active ? Theme.ok : Palette.foreground;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            Card {
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.is-en ? "Live Transcript" : "实时识别输出"; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Tag {
                            text: root.asr-status;
                            tint: root.asr-active ? Theme.ok : Theme.muted;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.is-en ? "Clear" : "清空";
                            clicked => { root.asr-clear(); }
                        }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        if root.asr-text != "": Text {
                            text: root.asr-text;
                            font-size: 15px;
                            wrap: word-wrap;
                        }
                        if root.asr-partial != "": Text {
                            text: root.asr-partial;
                            font-size: 15px;
                            color: Theme.npu;
                            wrap: word-wrap;
                        }
                        if root.asr-text == "" && root.asr-partial == "": Text {
                            text: root.asr-active ? (root.is-en ? "Speak into your microphone, live captions will appear here…" : "请对着麦克风说话，识别结果会实时显示在这里…") : (root.is-en ? "Click \"Start Live ASR\" on the left and speak into your microphone." : "点击左侧「开始实时转写」后，对着麦克风说话即可实时上屏。");
                            font-size: 13px;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        if root.active-tab == 3: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            VerticalLayout {
                width: 360px;
                spacing: 12px;

                Button {
                    height: 44px;
                    text: root.ocr-busy ? (root.is-en ? "Working…" : "处理中…") : (root.is-en ? "Snip & Recognize" : "框选屏幕识别");
                    primary: !root.ocr-busy;
                    enabled: !root.ocr-busy;
                    clicked => { root.ocr-snip(); }
                }

                Card {
                    title: root.is-en ? "OCR Backend" : "OCR 推理后端";
                    subtitle: root.is-en ? "Heterogeneous NPU+CPU (PP-OCRv4 INT8 backbones on NPU) or full CPU float32." : "NPU 跑密集卷积主干 + CPU 跑 FPN/SVTR 头，或切换全 CPU 参考。";
                    BackendOption {
                        label: root.is-en ? "NPU + CPU Heterogeneous" : "NPU + CPU 异构加速";
                        tag: root.is-en ? "Recommended" : "推荐";
                        hint: root.is-en ? "PP-OCRv4 INT8 backbones on NPU · Zero conv load on CPU" : "PP-OCRv4 主干跑 NPU INT8 · 大幅卸载主干卷积";
                        selected: root.ocr-backend == 0;
                        locked: root.ocr-busy;
                        clicked => { root.ocr-backend = 0; }
                    }
                    BackendOption {
                        label: root.is-en ? "CPU · Reference (float32)" : "CPU · 浮点参考";
                        hint: root.is-en ? "ONNX Runtime float32 · 4 threads" : "ONNX Runtime 浮点参考 · 4 线程";
                        selected: root.ocr-backend == 1;
                        locked: root.ocr-busy;
                        clicked => { root.ocr-backend = 1; }
                    }
                }

                GridLayout {
                    spacing: 8px;
                    Row {
                        StatTile {
                            label: root.is-en ? "Det Time" : "检测耗时";
                            value: root.ocr-det-ms;
                            unit: "ms";
                            accent: Theme.npu;
                        }
                        StatTile {
                            label: root.is-en ? "Rec Time" : "识别耗时";
                            value: root.ocr-rec-ms;
                            unit: "ms";
                            accent: Theme.ok;
                        }
                        StatTile {
                            label: root.is-en ? "Lines" : "检出行数";
                            value: root.ocr-boxes;
                            unit: "";
                            accent: Palette.foreground;
                        }
                    }
                }

                if root.ocr-has-preview: Card {
                    title: root.is-en ? "Captured Region" : "框选截图预览";
                    Rectangle {
                        height: 150px;
                        border-radius: 8px;
                        clip: true;
                        background: #00000018;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: root.ocr-preview;
                            image-fit: contain;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            Card {
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.is-en ? "Recognized Text" : "识别文本输出"; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Tag {
                            text: root.ocr-status;
                            tint: root.ocr-busy ? Theme.warn : Theme.ok;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.is-en ? "Copy All" : "复制全部";
                            enabled: root.ocr-text != "";
                            clicked => { root.ocr-copy(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: root.is-en ? "Clear" : "清空";
                            clicked => { root.ocr-clear(); }
                        }
                    }
                }
                TextEdit {
                    vertical-stretch: 1;
                    text <=> root.ocr-text;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
